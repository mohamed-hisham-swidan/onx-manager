# ── onx-manager ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env          (Linux / Mac / WSL)
#   copy .env.example .env        (Windows CMD)
#
# NEVER commit .env — it is gitignored.
# Primary environment variable prefix is ONX_ (legacy MCS_ is also accepted as a fallback).
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment Profile & Docker Ports ────────────────────────────────────────
# Panel Deployment Profile:
#   vps   — Full server panel (networking, multi-user RBAC/invites, full diagnostics, GitOps)
#   local — Streamlined personal desktop panel (collapses heavy VPS-only sections by default)
ONX_DEPLOYMENT_PROFILE=vps

# Docker Compose host port mappings (change if ports 80 or 8000 are already in use)
ONX_PANEL_PORT=80
ONX_API_PORT=8000

# Optional path to built frontend/dist for single-process serving (leave empty in Docker Nginx setups)
# ONX_STATIC_DIR=

# ── Core Application & Logging ───────────────────────────────────────────────
# ONX_APP_NAME=onx-manager
ONX_DEBUG=false
ONX_LOG_LEVEL=INFO
# ONX_LOG_JSON=true

# ── Database ─────────────────────────────────────────────────────────────────
# Default is SQLite (zero config, good for home and small-team use).
# For Docker, the path below matches the volume mount in docker-compose.yml (/app/data).
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
ONX_DATABASE_URL=sqlite+aiosqlite:////app/data/onx.db
# ONX_DATABASE_ECHO=false

# ── Security, JWT Keys & Master KEK (Advanced Mode / Vault) ──────────────────
# ONX_ALLOW_INSECURE_KEYS=false
# ONX_CORS_ORIGINS=["*"]

# JWT signing key:
# If omitted, a 2048-bit RSA key is auto-generated with 0600 permissions on first boot
# and persisted to /app/config/jwt_private_key.pem (onx-config volume).
# ONX_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# ONX_JWT_PRIVATE_KEY_PATH=/app/config/jwt_private_key.pem

# Master KEK (256-bit AES-GCM key-encryption key for live data vaults & secrets):
# On POSIX hosts/containers, a 0600 key file is auto-generated at first boot if unset.
# To pin an explicit KEK for offline recovery, generate 64 hex chars via: openssl rand -hex 32
# ONX_MASTER_KEK_FILE=/app/config/master_kek.key
# ONX_MASTER_KEK=

# ── Panel Bind & Rate Limiting ───────────────────────────────────────────────
# ONX_PANEL_BIND_HOST=127.0.0.1
# ONX_PANEL_BIND_PORT=8000
# ONX_RATE_LIMIT_PER_MINUTE=60
# ONX_IDEMPOTENCY_TTL_HOURS=24

# ── Resilience, Event Bus & Sagas ────────────────────────────────────────────
# ONX_CIRCUIT_BREAKER_TIMEOUT_SECONDS=30
# ONX_CIRCUIT_BREAKER_MAX_FAILURES=5
# ONX_EVENT_BUS_RETRY_ATTEMPTS=3
# ONX_EVENT_BUS_SUBSCRIBER_TIMEOUT=10.0
# ONX_SAGA_TIMEOUT_SECONDS=300

# ── Server Data, Runtime & Docker-outside-of-Docker (DooD) ───────────────────
# ONX_SERVERS_DATA_DIR=data/servers
# ONX_IMPORT_STAGING_DIR=data/staging
# ONX_IMPORT_MAX_ZIP_SIZE_MB=0
# ONX_FILES_MAX_UPLOAD_SIZE_MB=512
# ONX_METRICS_INTERVAL_SECONDS=5.0
# ONX_POST_RUNNING_GRACE_SECONDS=30.0
# ONX_SERVER_STARTUP_TIMEOUT_SECONDS=120
# ONX_TEST_BOOT_TIMEOUT_SECONDS=120
# ONX_DOCKER_DEFAULT_IMAGE=eclipse-temurin:21-jre-jammy
# ONX_DOCKER_TEST_IMAGE=itzg/minecraft-server:java25@sha256:dc7913a69c878594ff7b568862b2cd5541fac6e409d1dc86f0313b1ef7a4d9d4

# Required when using docker-compose.dood.yml (Docker-outside-of-Docker):
# Set these to absolute HOST paths so sibling Minecraft containers mount the right directories.
# ONX_HOST_DATA_DIR=/opt/onx-manager/backend/data/servers
# ONX_HOST_STATE_DIR=/app/data/host-state
# ONX_HOST_STATE_HOST_DIR=/opt/onx-manager/backend/data/host-state

# ── Plugins ──────────────────────────────────────────────────────────────────
# ONX_PLUGIN_PROVIDERS=modrinth

# ── Backup Encryption & Storage ──────────────────────────────────────────────
# A 32-byte AES key, auto-generated with 0600 permissions if the file does not exist.
# ONX_BACKUP_ENCRYPTION_KEY_PATH=/app/config/backup_encryption_key.bin
# Local (default) or s3
# ONX_STORAGE_BACKEND=local
# ONX_BACKUP_STORAGE_PATH=/app/data/backups

# ── S3 (only needed if ONX_STORAGE_BACKEND=s3) ───────────────────────────────
# ONX_S3_BUCKET=
# ONX_S3_REGION=us-east-1
# ONX_S3_ACCESS_KEY_ID=
# ONX_S3_SECRET_ACCESS_KEY=
# ONX_S3_ENDPOINT_URL=
