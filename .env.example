# ── MCS Manager ──────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env — it is gitignored.

MCS_DATABASE_URL=sqlite+aiosqlite:///data/mcs.db
MCS_SECRET_KEY=change-me-to-a-random-secret-in-production
MCS_DEBUG=false
MCS_LOG_LEVEL=INFO

# JWT private key — omit to auto-generate one on first start.
# If omitted, all JWTs are invalidated when the container restarts.
# MCS_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# MCS_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
