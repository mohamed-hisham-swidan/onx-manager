# ── onx-manager ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env          (Linux / Mac / WSL)
#   copy .env.example .env        (Windows CMD)
#
# NEVER commit .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Database — default is SQLite (zero config, good for home use).
# For Docker, the path below matches the volume mount in docker-compose.yml.
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
MCS_DATABASE_URL=sqlite+aiosqlite:////app/data/onx.db

# Secret key — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MCS_SECRET_KEY=change-me-to-a-random-secret-in-production

MCS_DEBUG=false
MCS_LOG_LEVEL=INFO

# ── JWT Keys ──────────────────────────────────────────────────────────────────
# If omitted, a key is auto-generated on first start.
# All existing JWTs are invalidated when the container restarts without a fixed key.
# Recommended: generate once and set here.
#
# Generate: openssl genrsa -out jwt_private.pem 4096
# Then paste the PEM (replace newlines with \n) or mount via file:
# MCS_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# MCS_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem

# ── Backup Encryption ─────────────────────────────────────────────────────────
# A 32-byte AES key, auto-generated and saved if the file doesn't exist.
# MCS_BACKUP_ENCRYPTION_KEY_PATH=/app/config/backup_encryption_key.bin

# ── Storage ───────────────────────────────────────────────────────────────────
# Local (default) or s3
# MCS_STORAGE_BACKEND=local
# MCS_BACKUP_STORAGE_PATH=/app/data/backups

# ── S3 (only needed if MCS_STORAGE_BACKEND=s3) ───────────────────────────────
# MCS_S3_BUCKET=
# MCS_S3_REGION=us-east-1
# MCS_S3_ACCESS_KEY_ID=
# MCS_S3_SECRET_ACCESS_KEY=
# MCS_S3_ENDPOINT_URL=
