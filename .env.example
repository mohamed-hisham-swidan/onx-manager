# ── MCS Manager ──────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env — it is gitignored.

MCS_DATABASE_URL=sqlite+aiosqlite:///data/mcs.db
MCS_SECRET_KEY=change-me-to-a-random-secret-in-production
MCS_DEBUG=false
MCS_LOG_LEVEL=INFO

# JWT private key — omit to auto-generate one on first start.
# If omitted, all JWTs are invalidated when the container restarts.
# MCS_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# MCS_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem

# Backup encryption key — omit to auto-generate one on first start.
# A 32-byte key is generated and persisted to this path if the file is missing.
# If omitted, the key is written to config/backup_encryption_key.bin.
# MCS_BACKUP_ENCRYPTION_KEY_PATH=config/backup_encryption_key.bin

# Storage backend: "local" (default) or "s3".
# MCS_STORAGE_BACKEND=local
# Local backup base directory (relative to the backend working directory).
# MCS_BACKUP_STORAGE_PATH=data/backups

# S3 settings — only required when MCS_STORAGE_BACKEND=s3.
# MCS_S3_BUCKET=
# MCS_S3_REGION=us-east-1
# MCS_S3_ACCESS_KEY_ID=
# MCS_S3_SECRET_ACCESS_KEY=
# MCS_S3_ENDPOINT_URL=
