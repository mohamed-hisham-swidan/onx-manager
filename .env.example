# ── onx-manager ──────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env — it is gitignored.

ONX_DATABASE_URL=sqlite+aiosqlite:///data/onx.db
ONX_SECRET_KEY=change-me-to-a-random-secret-in-production
ONX_DEBUG=false
ONX_LOG_LEVEL=INFO

# JWT private key — omit to auto-generate one on first start.
# If omitted, all JWTs are invalidated when the container restarts.
# ONX_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# ONX_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem

# Backup encryption key — omit to auto-generate one on first start.
# A 32-byte key is generated and persisted to this path if the file is missing.
# If omitted, the key is written to config/backup_encryption_key.bin.
# ONX_BACKUP_ENCRYPTION_KEY_PATH=config/backup_encryption_key.bin

# Storage backend: "local" (default) or "s3".
# ONX_STORAGE_BACKEND=local
# Local backup base directory (relative to the backend working directory).
# ONX_BACKUP_STORAGE_PATH=data/backups

# Plugin catalog provider. Accepts EXACTLY ONE configured provider; the
# only registered provider is "modrinth" (the default). Configuring more than
# one provider fails fast at startup.
#
# The comma-separated LIST syntax is intentionally preserved (e.g.
# ONX_PLUGIN_PROVIDERS=modrinth) for forward compatibility with future multiple providers.
# ONX_PLUGIN_PROVIDERS=modrinth

# S3 settings — only required when ONX_STORAGE_BACKEND=s3.
# ONX_S3_BUCKET=
# ONX_S3_REGION=us-east-1
# ONX_S3_ACCESS_KEY_ID=
# ONX_S3_SECRET_ACCESS_KEY=
# ONX_S3_ENDPOINT_URL=
