#!/usr/bin/env python3
"""Verify that all tracked PowerShell (.ps1) files contain a UTF-8 BOM (EF BB BF).

Windows PowerShell 5.1 requires a UTF-8 BOM to correctly parse non-ASCII characters
(such as em dashes and box-drawing characters). Without a BOM, PowerShell 5.1 can
misinterpret multi-byte characters and fail with syntax errors.

Uses `git ls-files` to check only tracked .ps1 files, excluding gitignored/untracked files.
Exit code 0 if all tracked .ps1 files have a valid UTF-8 BOM, 1 otherwise.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parents[1]
_UTF8_BOM = b"\xef\xbb\xbf"


def get_tracked_ps1_files(repo_root: Path) -> list[Path]:
    """Retrieve all tracked .ps1 files using git ls-files."""
    result = subprocess.run(
        ["git", "ls-files", "*.ps1", "**/*.ps1"],
        cwd=repo_root,
        capture_output=True,
        text=True,
        check=True,
    )
    paths: set[Path] = set()
    for line in result.stdout.splitlines():
        rel_path = line.strip()
        if rel_path.endswith(".ps1"):
            paths.add(repo_root / rel_path)
    return sorted(paths)


def check_ps1_bom(file_path: Path) -> bool:
    """Check if the given file starts with the UTF-8 BOM."""
    try:
        with file_path.open("rb") as f:
            header = f.read(3)
        return header == _UTF8_BOM
    except OSError as err:
        print(f"Error reading {file_path}: {err}", file=sys.stderr)
        return False


def main() -> int:
    tracked_files = get_tracked_ps1_files(_REPO_ROOT)
    if not tracked_files:
        print("No tracked .ps1 files found.")
        return 0

    failed_files: list[Path] = []
    for ps1_file in tracked_files:
        rel = ps1_file.relative_to(_REPO_ROOT)
        if check_ps1_bom(ps1_file):
            print(f"PASS: {rel} contains valid UTF-8 BOM")
        else:
            print(f"FAIL: {rel} is MISSING required UTF-8 BOM (0xEF 0xBB 0xBF)", file=sys.stderr)
            failed_files.append(ps1_file)

    if failed_files:
        print(
            f"\nError: {len(failed_files)} tracked PowerShell script(s) missing UTF-8 BOM:",
            file=sys.stderr,
        )
        for f in failed_files:
            print(f"  - {f.relative_to(_REPO_ROOT)}", file=sys.stderr)
        print(
            "\nRemediation: Re-save the file(s) with UTF-8 BOM encoding (EF BB BF) for PowerShell 5.1 compatibility.",
            file=sys.stderr,
        )
        return 1

    print(f"\nAll {len(tracked_files)} tracked .ps1 file(s) verified with UTF-8 BOM.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
