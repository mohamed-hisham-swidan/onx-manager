{
  "name": "onx-manager-desktop",
  "version": "0.1.0",
  "description": "ONX Manager Desktop Shell — lightweight Electron wrapper for Local and Remote ONX panels",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/main.js",
  "desktopName": "onx-manager.desktop",
  "scripts": {
    "prestart": "node scripts/ensure-electron.js",
    "start": "electron .",
    "predev": "node scripts/ensure-electron.js",
    "dev": "electron . --dev",
    "lint": "node --check src/main.js && node --check src/preload.js && node --check src/backendManager.js && node --check src/connectionsStore.js && node --check src/launcher.js && node --check scripts/ensure-electron.js",
    "test": "node --test src/test",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.onxmanager.desktop",
    "productName": "ONX Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!src/test/**"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "executableName": "onx-manager",
      "syncDesktopName": true,
      "artifactName": "ONX-Manager-${version}-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "desktop": {
        "entry": {
          "Name": "ONX Manager",
          "StartupWMClass": "onx-manager"
        }
      }
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
