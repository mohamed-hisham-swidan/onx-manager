{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerConfig",
  "description": "Immutable server configuration schema",
  "type": "object",
  "required": ["minecraft_version", "memory_min_mb", "memory_max_mb", "port"],
  "properties": {
    "minecraft_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Minecraft version (e.g. 1.21.4)"
    },
    "memory_min_mb": {
      "type": "integer",
      "minimum": 1024,
      "description": "Minimum heap memory in MB"
    },
    "memory_max_mb": {
      "type": "integer",
      "minimum": 1024,
      "description": "Maximum heap memory in MB"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "description": "Minecraft server port"
    },
    "java_args": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" }
        },
        {
          "type": "string"
        }
      ],
      "description": "Additional JVM arguments"
    },
    "provider_type": {
      "type": "string",
      "enum": ["local", "docker", "remote", "cloud", "local_win"],
      "default": "local"
    },
    "stop_timeout_seconds": {
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "maximum": 300
    }
  },
  "allOf": [
    {
      "if": { "properties": { "provider_type": { "const": "remote" } } },
      "then": {
        "required": ["ssh_host", "ssh_user", "ssh_key_path"]
      }
    }
  ]
}
